@model List<Comment>
@{
    ViewData["Title"] = "Все комментарии";
}
<h1>Все комментарии</h1>
<table class="table">
    <thead><tr><th>Автор</th><th>Статья</th><th>Текст</th><th>Дата</th><th></th></tr></thead>
    <tbody>
    @foreach (var comment in Model)
    {
        <tr>
            <td>@comment.User?.UserName</td>
            <td><a asp-controller="Article" asp-action="Details" asp-route-id="@comment.ArticleId">@comment.Article?.Title</a></td>
            <td>@comment.Content</td>
            <td>@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td>
                <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
