@model Article
@{
    ViewData["Title"] = "Удаление статьи";
}
<h1>Удаление статьи</h1>
<p>Вы уверены, что хотите удалить статью <strong>@Model.Title</strong>? Это действие также удалит все связанные комментарии.</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Отмена</a>
</form>
