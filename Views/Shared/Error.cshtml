@model ErrorViewModel
@{
    ViewData["Title"] = "Что-то пошло не так";
}
<h1 class="text-danger">Что-то пошло не так</h1>
<p>Во время обработки запроса возникла непредвиденная ошибка.</p>
@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}
<a asp-controller="Article" asp-action="Index" class="btn btn-secondary">На главную</a>